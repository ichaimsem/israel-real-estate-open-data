     },
     "company_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "areas": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "specialties": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "project_ids": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "projects_url": {
      "type": "string",
      "format": "uri"
     }
    }
   },
