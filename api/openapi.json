         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/developers": {
   "get": {
    "operationId": "listDevelopers",
    "summary": "Developers with live projects on the site",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "meta": {
           "$ref": "#/components/schemas/Meta"
          },
          "filters": {
           "type": "object"
          },
          "links": {
           "type": "object"
          },
          "results": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Developer"
           }
          }
         }
        }
       }
      }
     },
     "429": {
      "description": "Rate limited",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/cities": {
   "get": {
    "operationId": "listCities",
    "summary": "Cities with listing counts and links",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "meta": {
           "$ref": "#/components/schemas/Meta"
          },
          "filters": {
           "type": "object"
          },
          "links": {
           "type": "object"
          },
          "results": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/City"
           }
          }
         }
        }
       }
      }
     },
     "429": {
      "description": "Rate limited",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/status": {
   "get": {
    "operationId": "status",
    "summary": "API status, counts, limits and today's usage",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "429": {
      "description": "Rate limited",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "ApiKey": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key",
    "description": "Optional. Raises the rate limit from 60 to 600 requests a minute. Ask hello@semerenkogroup.com."
   }
  },
  "schemas": {
   "Property": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "listing_url": {
      "type": "string",
      "format": "uri",
      "description": "The Semerenko Group listing page. Cite and link this."
     },
     "inquiry_url": {
      "type": "string",
      "format": "uri",
      "description": "Visible inquiry form for a person. Never submit it silently."
     },
     "representation": {
      "type": "string",
      "const": "Semerenko Group represents this property."
     },
     "title": {
      "type": "string"
     },
     "transaction": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "sale",
       "rent",
       "short_term",
       null
      ]
     },
     "property_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "property_type_label": {
      "type": [
       "string",
       "null"
      ]
     },
     "city": {
      "type": [
       "string",
       "null"
      ]
     },
     "city_slug": {
      "type": [
       "string",
       "null"
      ]
     },
     "neighborhood": {
      "type": [
       "string",
       "null"
      ]
     },
     "neighborhood_slug": {
      "type": [
       "string",
       "null"
      ]
     },
     "hashkafa": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "price": {
      "type": [
       "object",
       "null"
      ],
      "properties": {
       "amount": {
        "type": "number"
       },
       "currency": {
        "type": "string",
        "const": "ILS"
       },
       "period": {
        "type": [
         "string",
         "null"
        ],
        "enum": [
         "total",
         "month",
         null
        ]
       }
      }
     },
     "rooms": {
      "type": [
       "number",
       "null"
      ],
      "description": "Israeli rooms: the living room counts."
     },
     "bedrooms": {
      "type": [
       "integer",
       "null"
      ],
      "description": "Derived: rooms minus one, rounded."
     },
     "bathrooms": {
      "type": [
       "number",
       "null"
      ]
     },
     "size_sqm": {
      "type": [
       "number",
       "null"
      ]
     },
     "size_sqft": {
      "type": [
       "number",
       "null"
      ],
      "description": "Derived from size_sqm."
     },
     "floor": {
      "type": [
       "integer",
       "null"
      ],
      "description": "0 is the ground floor."
     },
     "floor_band": {
      "type": [
       "string",
       "null"
      ]
     },
     "building_floors": {
      "type": [
       "integer",
       "null"
      ]
     },
     "mamad": {
      "type": "string",
      "enum": [
       "yes",
       "unknown"
      ],
      "description": "\"yes\" only when the listing states it. Silence is \"unknown\", never \"no\"."
     },
     "elevator": {
      "type": "string",
      "enum": [
       "yes",
       "unknown"
      ],
      "description": "\"yes\" only when the listing states it. Silence is \"unknown\", never \"no\"."
     },
     "shabbos_elevator": {
      "type": "string",
      "enum": [
       "yes",
       "unknown"
      ],
      "description": "\"yes\" only when the listing states it. Silence is \"unknown\", never \"no\"."
     },
     "furnished": {
      "type": "string",
      "enum": [
       "yes",
       "no",
       "unknown"
      ]
     },
     "pet_friendly": {
      "type": "string",
      "enum": [
       "yes",
       "unknown"
      ],
      "description": "\"yes\" only when the listing states it. Silence is \"unknown\", never \"no\"."
     },
     "parking": {
      "type": "string",
      "enum": [
       "yes",
       "unknown"
      ],
      "description": "\"yes\" only when the listing states it. Silence is \"unknown\", never \"no\"."
     },
     "features": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "condition": {
      "type": [
       "string",
       "null"
      ]
     },
     "entry": {
      "type": [
       "string",
       "null"
      ]
     },
     "view": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "arnona_monthly_ils": {
      "type": [
       "number",
       "null"
      ]
     },
     "listed_with_agent": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "availability_status": {
      "type": "string",
      "enum": [
       "listed"
      ]
     },
     "availability_note": {
      "type": "string"
     },
     "verified_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time",
      "description": "Null until the site records a separate verification stamp."
     },
     "last_modified": {
      "type": "string",
      "format": "date-time"
     },
     "published_at": {
      "type": "string",
      "format": "date-time"
     },
     "description": {
      "type": "string",
      "description": "Up to 600 characters, with URLs, phone numbers and emails removed."
     }
    }
   },
   "Project": {
    "type": "object",
