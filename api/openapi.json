       "null"
      ]
     },
     "last_modified": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Developer": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "profile_url": {
      "type": "string",
